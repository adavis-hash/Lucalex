# ==============================================================================
# Supabase Configuration — Lucalex E-Commerce Storefront
# ==============================================================================
# Copy this file to .env.local and fill in your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env.local to Git (strictly ignored via .gitignore).
# 2. Never expose SUPABASE_SECRET_KEY in client components, NEXT_PUBLIC_* variables,
#    HTTP responses, or browser bundles.
# 3. Standard storefront operations (browsing catalog, cart, user profiles, orders)
#    MUST use Row Level Security (RLS) via NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mandatory Public Credentials (Accessible in browser and server)
# ------------------------------------------------------------------------------
# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Modern Supabase Publishable Key (safe for client bundles, constrained by RLS)
# Note: Also backwards-compatible if you have an anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ------------------------------------------------------------------------------
# 2. Optional Server-Only Admin Key (Bypasses Row Level Security)
# ------------------------------------------------------------------------------
# Only required if you execute server-only administrative tasks or scripts
# (e.g., npx tsx scripts/seed.ts). NOT needed for normal storefront operation.
# SUPABASE_SECRET_KEY=your-supabase-secret-key-here
