# ==============================================================================
# Supabase Configuration — Lucalex E-Commerce Storefront
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase Project Settings:
# https://app.supabase.com/project/_/settings/api

# Public URL of your Supabase instance (accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe to expose in client-side bundles, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Service Role Key (NEVER expose to the client; server-side admin only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
